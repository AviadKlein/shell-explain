   "text": "on('tool.check', { tool: 'Bash' })\nverdict = await next(e)\nif verdict.decision == 'ask'\n   && approver != 'host' (not IDE-answered)\n   && isOn atom is true\n   → void explain(tool_use_id, command)\nreturn verdict unchanged",
   "originalText": "on('tool.check', { tool: 'Bash' })\nverdict = await next(e)\nif verdict.decision == 'ask'\n   && approver != 'host' (not IDE-answered)\n   && isOn atom is true\n   → void explain(tool_use_id, command)\nreturn verdict unchanged",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "M2",
   "lineHeight": 1.25,
